package charleywong;

import js.html.URL;
import js.lib.Promise;
import js.lib.ArrayBuffer;
import js.lib.Uint8Array;
import haxe.DynamicAccess;
import charleywong.Search;
using StringTools;

typedef WorkerIndex = {
    final profilePicOrigin:String;
    final mooncake2020Path:String;
    final hkbaseDirectoryPath:String;
    /**
        [id, removed, list item html], in the same order as the lines of entities.bin
    **/
    final entities:Array<Array<Dynamic>>;
    final aliases:DynamicAccess<Int>;
    final search:{
        final docs:Array<SearchDoc>;
        final dict:SearchDict;
    };
    final templates:{
        final search:String;
        final list:String;
    };
    final staticFiles:DynamicAccess<String>;
    final postImages:DynamicAccess<String>;
}

/**
    The Cloudflare Worker that handles the requests that are not static assets
    (search, custom entity lists, post image proxy, aliases, 404).
    See `worker/index.js` for the entry point.
**/
@:expose("CharleyWong")
class WorkerMain {
    static var index:WorkerIndex;
    /**
        Newline-delimited JSON of the entities, as UTF-8 bytes, such that responses can be assembled by copying bytes.
    **/
    static var entityBytes:Uint8Array;
    static var entityStarts:Array<Int>;
    static var entityEnds:Array<Int>;
    static var indexOfId:DynamicAccess<Int>;

    /**
        Should be called in the global scope (Worker startup),
        which isn't counted towards the per-request CPU time limit.
    **/
    static public function init(indexText:String, entitiesData:ArrayBuffer):Void {
        index = haxe.Json.parse(indexText);
        entityBytes = new Uint8Array(entitiesData);
        entityStarts = [0];
        entityEnds = [];
        final newline = "\n".code;
        for (i in 0...entityBytes.length) {
            if (entityBytes[i] == newline) {
                entityEnds.push(i);
                entityStarts.push(i + 1);
            }
        }
        entityEnds.push(entityBytes.length);
        indexOfId = {};
        for (i => e in index.entities)
            indexOfId[e[0]] = i;
    }

    static function escapeHtml(s:String):String {
        // same as React's escapeTextContentForBrowser
        return s
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace('"', "&quot;")
            .replace("'", "&#x27;");
    }

    static function response(body:Any, status:Int, contentType:String, ?cacheControl:String):Dynamic {
        final headers:DynamicAccess<String> = {
            "Content-Type": contentType,
            "Access-Control-Allow-Origin": "*",
        };
        if (cacheControl != null)
            headers["Cache-Control"] = cacheControl;
        return js.Syntax.code("new Response({0}, { status: {1}, headers: {2} })", body, status, headers);
    }

    static function text(body:String, status:Int):Dynamic {
        return response(body, status, "text/plain; charset=utf-8");
    }

    static function redirect(location:String, status:Int = 302, ?cacheControl:String):Dynamic {
        final headers:DynamicAccess<String> = {
            "Location": location,
            "Access-Control-Allow-Origin": "*",
        };
        if (cacheControl != null)
            headers["Cache-Control"] = cacheControl;
        return js.Syntax.code("new Response(null, { status: {0}, headers: {1} })", status, headers);
    }

    static function json(entities:Array<Int>, ?cacheControl:String):Dynamic {
        var length = 2 + (entities.length > 0 ? entities.length - 1 : 0);
        for (i in entities)
            length += entityEnds[i] - entityStarts[i];
        final body = new Uint8Array(length);
        body[0] = "[".code;
        var pos = 1;
        for (n => i in entities) {
            if (n > 0)
                body[pos++] = ",".code;
            body.set(entityBytes.subarray(entityStarts[i], entityEnds[i]), pos);
            pos += entityEnds[i] - entityStarts[i];
        }
        body[pos] = "]".code;
        return response(body, 200, "application/json; charset=utf-8", cacheControl);
    }

    static function entityOf(id:String):Null<Int> {
        return switch (indexOfId[id]) {
            case null: index.aliases[id];
            case i: i;
        }
    }

    /**
        Fill in the placeholders of a page template generated by `StaticSiteMain`.
    **/
    static function fill(template:String, values:DynamicAccess<String>, entities:Array<Int>):String {
        values["COUNT"] = Std.string(entities.length);
        values["LIST"] = entities.map(i -> (index.entities[i][2]:String)).join("");
        // same as the prefetch of EntityListView
        values["PREFETCH"] = entities.length > 5 ? "" : entities.map(i -> {
            final id:String = index.entities[i][0];
            '<link rel="prefetch" href="/${escapeHtml(id)}"/><link rel="prefetch" href="${escapeHtml(index.profilePicOrigin + Site.profilePicPath(id))}"/>';
        }).join("");
        // replace all placeholders in a single pass, such that the values are never re-substituted
        return ~/%%CW_([A-Z_]+)%%/g.map(template, re -> values[re.matched(1)]);
    }

    static function decodePath(s:String):Null<String> {
        return try {
            // same as StringTools.urlDecode, which was used by the server
            js.Lib.global.decodeURIComponent(s.split("+").join(" "));
        } catch (e) {
            null;
        }
    }

    static function search(path:String):Dynamic {
        final query = decodePath(path.substr("/search/".length));
        if (query == null)
            return text("Malformed search query.", 400);
        final cacheControl = "public, max-age=3600, stale-while-revalidate=604800"; // max-age: 1 hour, stale-while-revalidate: 7 days
        if (query.endsWith(".json")) {
            final query = query.substr(0, -".json".length);
            return json(Search.search(index.search.docs, index.search.dict, query), cacheControl);
        }
        switch (query.trim().toLowerCase()) {
            case "月餅" | "mooncake":
                return redirect("/" + index.mooncake2020Path);
            case "hkbase":
                return redirect("/" + index.hkbaseDirectoryPath);
            case _:
                //pass
        }
        final entities = Search.search(index.search.docs, index.search.dict, query);
        final html = fill(index.templates.search, {
            QUERY: escapeHtml(query),
            SLUG: escapeHtml(query.urlEncode()),
        }, entities);
        return response(html, 200, "text/html; charset=utf-8", cacheControl);
    }

    static function list(name:String, ids:String):Dynamic {
        final returnJson = ids.endsWith(".json");
        if (returnJson)
            ids = ids.substr(0, -".json".length);
        final entities = [];
        for (id in ids.split("+")) {
            switch (entityOf(id)) {
                case null:
                    return text('Entity of id "$id" not found', 404);
                case i:
                    entities.push(i);
            }
        }
        if (returnJson)
            return json(entities);
        final html = fill(index.templates.list, {
            LIST_NAME: escapeHtml(name),
            PATH: escapeHtml(haxe.io.Path.join(["list", name, ids])),
            SLUG: escapeHtml(ids),
        }, entities);
        return response(html, 200, "text/html; charset=utf-8");
    }

    static function proxyImage(post:Null<String>):Promise<Dynamic> {
        return switch (index.postImages[post]) {
            case null:
                Promise.resolve(text('$post doesn\'t provide "og:image".', 404));
            case imageUrl:
                js.Syntax.code("fetch({0}, { cf: { cacheEverything: true, cacheTtl: 86400 } })", imageUrl)
                    .then(r -> {
                        final headers = js.Syntax.code("new Headers({0}.headers)", r);
                        headers.set("Cache-Control", "public, max-age=86400, stale-while-revalidate=2628000"); // max-age: 1 day, stale-while-revalidate: one month
                        headers.set("Access-Control-Allow-Origin", "*");
                        js.Syntax.code("new Response({0}.body, { status: {0}.status, headers: {1} })", r, headers);
                    });
        }
    }

    static function entity(segment:String):Dynamic {
        final returnJson = segment.endsWith(".json");
        final id = returnJson ? segment.substr(0, -".json".length) : segment;
        final notFound = text('Entity of id $id not found.', 404);
        return switch (entityOf(id)) {
            case null:
                notFound;
            case i if (index.entities[i][1]): // removed
                notFound;
            case i:
                final realId:String = index.entities[i][0];
                if (realId != id)
                    redirect("/" + realId + (returnJson ? ".json" : ""));
                else
                    // the static asset should have been served
                    notFound;
        }
    }

    static function route(request:Dynamic):Promise<Dynamic> {
        final url = new URL(request.url);
        final path = url.pathname;

        if (request.method != "GET" && request.method != "HEAD")
            return Promise.resolve(text("Method not allowed.", 405));

        if (path.length > 1 && path.endsWith("/"))
            return Promise.resolve(redirect(path.substr(0, path.length - 1) + url.search, 301));

        if (path == "/search") {
            return Promise.resolve(switch (url.searchParams.get("search")) {
                case null:
                    redirect("/");
                case _.trim() => "":
                    redirect("/list/all");
                case search:
                    redirect("/search/" + search.trim().urlEncode());
            });
        }

        if (path.startsWith("/search/"))
            return Promise.resolve(search(path));

        if (path == "/proxy/image")
            return proxyImage(url.searchParams.get("post"));

        switch (index.staticFiles[decodePath(path)]) {
            case null:
                //pass
            case fingerprinted:
                return Promise.resolve(redirect(fingerprinted, 302, "public, max-age=0, stale-while-revalidate=604800")); // stale-while-revalidate: 7 days
        }

        return Promise.resolve(switch (path.split("/")) {
            case ["", "list", name, ids]:
                switch (decodePath(name)) {
                    case null: text("Malformed list name.", 400);
                    case name: list(name, ids);
                }
            case ["", id, "profile.png"]:
                switch (entityOf(id)) {
                    case null:
                        text('Entity of id $id not found.', 404);
                    case i if (index.profilePicOrigin != ""):
                        redirect(index.profilePicOrigin + Site.profilePicPath(index.entities[i][0]), 301);
                    case _:
                        text("Not found.", 404);
                }
            case ["", segment] if (segment != ""):
                entity(segment);
            case _:
                text("Not found.", 404);
        });
    }

    /**
        Search results are cached with the Cache API, since Worker responses don't go through Cloudflare's cache.
    **/
    static public function fetch(request:Dynamic, env:Dynamic, ctx:Dynamic):Promise<Dynamic> {
        final cache:Dynamic = js.Syntax.code("caches.default");
        final cacheable = request.method == "GET" && new URL(request.url).pathname.startsWith("/search/");
        if (!cacheable)
            return route(request);
        return cache.match(request).then(cached -> {
            if (cached != null)
                return Promise.resolve(cached);
            return route(request).then(r -> {
                if (r.status == 200)
                    ctx.waitUntil(cache.put(request, r.clone()));
                r;
            });
        });
    }
}
