// Assets-only Worker serving the entity profile pics (img.charleywong.info),
// generated by `node profilePic.js` into dist/img.
// It is separated from the main site because of the 20,000 files limit of Workers static assets.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "charleywong-img",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist/img",
    "not_found_handling": "none"
  },
  "workers_dev": true
}
