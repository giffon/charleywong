// Assets-only Worker serving the entity profile pics (img.charleywong.info),
// generated by `node profilePic.js` into dist/img.
// It is separated from the main site because of the 20,000 files limit of Workers static assets.
// The route needs the proxied DNS record of img.charleywong.info, which is managed in terraform/cloudflare.tf.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "charleywong-img",
  "account_id": "f184c98e4ba41baaf6a081d9d6e599e6",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist/img",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "img.charleywong.info/*", "zone_name": "charleywong.info" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
